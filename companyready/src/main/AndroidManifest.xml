<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions needed: links open in your browser, calendar reminders open your
         calendar app, and exports/receipts use the system file picker. All data stays on the phone. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CompanyReady">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".StepActivity" android:exported="false" />
        <activity android:name=".QuizActivity" android:exported="false" />
        <activity android:name=".RecordsActivity" android:exported="false" />
        <activity
            android:name=".EntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MileageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DeadlinesActivity" android:exported="false" />
        <activity
            android:name=".CalculatorsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GlossaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AboutActivity" android:exported="false" />
    </application>
</manifest>
